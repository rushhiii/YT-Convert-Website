# Samsung Music Clone - Environment Variables

# Server Configuration
NODE_ENV=development
PORT=5000

# Client URL
CLIENT_URL=http://localhost:3000

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/samsung-music

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=30d

# AWS S3 Configuration (for file storage)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=samsung-music-files

# Redis Configuration (for caching and sessions)
REDIS_URL=redis://localhost:6379

# Email Configuration (for notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-email-password
EMAIL_FROM=Samsung Music <noreply@samsungmusic.com>

# Logging Configuration
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload Limits
MAX_FILE_SIZE=50000000
MAX_FILES_PER_UPLOAD=10

# Security
BCRYPT_ROUNDS=12
SESSION_SECRET=your-session-secret-key

# Third-party APIs
LAST_FM_API_KEY=your-lastfm-api-key
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret

# Push Notifications
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_EMAIL=mailto:your-email@example.com

# Analytics
GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X

# Development Settings
ENABLE_CORS=true
ENABLE_MORGAN_LOGGING=true
ENABLE_REQUEST_LOGGING=true
